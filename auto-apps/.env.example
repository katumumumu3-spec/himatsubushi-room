# 環境変数の例（GitHub Secrets またはローカル .env）
# Firebase サービスアカウントJSONを1行文字列で入れるか、ファイルを用意する

# 公開ベースURL（末尾スラッシュなし）
APPS_BASE_URL=https://apps.himatsubushiroom.com

# Firestore プロジェクトID
FIREBASE_PROJECT_ID=himatubusi-7cb7d

# サービスアカウントJSON（全文）。GitHub Secrets では FIREBASE_SERVICE_ACCOUNT に設定
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# ローカル検証時はファイルパスでも可
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# 公開確認の最大待機秒数
PUBLISH_WAIT_SECONDS=180
